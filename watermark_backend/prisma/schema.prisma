generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("clinics")
}

model User {
  id           Int      @id @default(autoincrement())
  /// 포털 userId(cuid)
  externalId   String   @unique @map("external_id")
  email        String   @db.VarChar(200)
  name         String   @db.VarChar(50)
  provider     String?  @db.VarChar(20)
  clinicId     Int      @map("clinic_id")
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // 사용자별 데이터 관계
  images              Image[]
  logos               Logo[]
  settings            Settings[]
  annotationTemplates AnnotationTemplate[]

  @@map("users")
}

model Image {
  id           String   @id @default(uuid())
  originalName String
  filename     String
  url          String
  width        Int
  height       Int
  size         Int
  mimeType     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 사용자 관계 (nullable — 기존 데이터 호환)
  ownerId      Int?     @map("owner_id")
  owner        User?    @relation(fields: [ownerId], references: [id])

  @@map("images")
}

model Logo {
  id        String   @id @default(uuid())
  name      String
  filename  String
  url       String
  width     Int
  height    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 사용자 관계 (nullable — 기존 데이터 호환)
  ownerId   Int?     @map("owner_id")
  owner     User?    @relation(fields: [ownerId], references: [id])

  @@map("logos")
}

model Settings {
  id            String   @id @default(uuid())
  name          String   @default("default")
  logoPositionX Float    @default(0.02)
  logoPositionY Float    @default(0.02)
  logoAnchor    String   @default("top-left")
  logoScale     Float    @default(0.3)
  logoOpacity   Float    @default(1)
  datePositionX Float    @default(0.02)
  datePositionY Float    @default(0.06)
  dateFormat    String   @default("YY.MM")
  fontFamily    String   @default("Pretendard")
  fontSize      Int      @default(24)
  fontColor     String   @default("#FFFFFF")
  dateScale     Float    @default(0.15)
  dateOpacity   Float    @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 사용자 관계 (nullable — 기존 데이터 호환)
  ownerId       Int?     @map("owner_id")
  owner         User?    @relation(fields: [ownerId], references: [id])

  @@map("settings")
}

model AnnotationTemplate {
  id           String   @id @default(uuid())
  name         String
  type         String
  color        String   @default("#FF0000")
  thickness    Int      @default(2)
  lineStyle    String   @default("solid")
  borderRadius Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 사용자 관계 (nullable — 기존 데이터 호환)
  ownerId      Int?     @map("owner_id")
  owner        User?    @relation(fields: [ownerId], references: [id])

  @@map("annotation_templates")
}

model ProcessedImage {
  id           String   @id @default(uuid())
  originalId   String
  filename     String
  url          String
  settings     Json
  createdAt    DateTime @default(now())

  @@map("processed_images")
}
