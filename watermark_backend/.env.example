# Server
PORT=4000
NODE_ENV=production

# Database (MySQL - AWS RDS)
DATABASE_URL="mysql://user:password@your-rds-endpoint:3306/watermark_db"

# AWS S3 (Required for production)
USE_S3=true
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="ap-northeast-2"

# Upload settings (for local development when USE_S3=false)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Frontend URL (CORS)
FRONTEND_URL="https://your-vercel-app.vercel.app"

# Sub Domain API Key (메인 프로젝트 연동)
SUB_DOMAIN_API_KEY=""

# 포털 중앙 포인트 원장 발행 (전사 리더보드)
# 미설정(INTERNAL_API_SECRET 없음) 시 발행을 조용히 skip → 이미지 처리는 정상 동작
PORTAL_INTERNAL_API_URL="https://api.koco.me"
INTERNAL_API_SECRET=""
